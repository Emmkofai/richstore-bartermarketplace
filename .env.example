# RichStore — environment template
# Copy this file to `.env` in the same folder as server.js and fill in the values.
# `.env` is read at startup: RESTART the server after changing anything here.
# Never commit `.env`.

# ---------------------------------------------------------------- storefront / API
PORT=3000
# The admin console's port (read by server.js for its CORS allow-list).
ADMIN_PORT=4000
# Absolute public URL of the storefront. Required for gateway callbacks and webhooks.
PUBLIC_BASE_URL=http://localhost:3000
# Extra browser origins allowed to call the API cross-origin, comma separated.
# Requests from an origin whose hostname matches the host they arrived on are allowed
# automatically, so the admin console works from localhost or a LAN address.
# ALLOWED_ORIGINS=https://richstore.example

# ------------------------------------------------------------- payment gateway
# LEAVE BLANK to run in transfer-only mode: buyers are shown the mobile-money number
# and a payment reference, and an operator confirms each transfer in the admin
# console (Payments tab).
#
# WARNING — read before setting: while PAYSTACK_SECRET_KEY is empty, paystack.js runs
# in SIMULATION mode and its initialize/verify/transfer calls report fake success.
# The server refuses to trust those results (gatewayIsLive()), so nothing is ever
# marked paid or paid out on the strength of a simulation.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ------------------------------------------------- platform settlement account
PLATFORM_TELECEL_PHONE=0501373335
PLATFORM_TELECEL_NAME=RichStore Platform Treasury
PLATFORM_SITE_FEE_PERCENT=5

# ------------------------------------------------------------------- webhooks
# Shared secret for the telco SMS webhook. The forwarder sends
# HMAC-SHA256(raw body) in the `x-richstore-signature` header.
# If this is empty the webhook FAILS CLOSED — it rejects every request rather than
# trusting a forgeable empty-key signature. The site itself still runs.
NATIVE_GATEWAY_SECRET=

# Register this URL as the Paystack webhook (Paystack signs with PAYSTACK_SECRET_KEY):
#   https://<your-domain>/api/webhooks/paystack
# Host these behind HTTPS: the payment callback and both webhooks must be reachable.

# ----------------------------------------------------------------- behaviours
# How long a buyer has to pay before the order expires and its stock is released.
PAYMENT_WINDOW_MS=86400000

# ------------------------------------------------------------------- SMS / OTP
# SMS provider credentials — without them verification codes are not sent.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
# Development only: print OTP codes to the server console. NEVER enable in production.
# OTP_DEV_ECHO=1

# ------------------------------------------------------------------- operations
# Only set this behind a reverse proxy you control: it makes the server trust
# X-Forwarded-For / X-Forwarded-Proto for client IP and protocol.
# TRUST_PROXY=1
# Development only: relax API rate limits.
# DEV_RELAX_RATE_LIMITS=1
